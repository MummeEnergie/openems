#!/usr/bin/with-contenv bash
# shellcheck shell=bash

if pgrep -f "[n]ginx:" >/dev/null; then
    echo "Zombie nginx processes detected, sending SIGTERM"
    pkill -ef [n]ginx:
    sleep 1
fi

if pgrep -f "[n]ginx:" >/dev/null; then
    echo "Zombie nginx processes still active, sending SIGKILL"
    pkill -9 -ef [n]ginx:
    sleep 1
fi

if [[ "$UI_WEBSOCKET" == *"<hostname>"* ]]; then
    echo ""
    echo "UI_WEBSOCKET contains <hostname> placeholder, replace it with the actual hostname or IP address of the Docker host."
    sleep infinity
fi

# notification-fd 3 verlangt eine Bereitschaftsmeldung. nginx schreibt sie
# nicht selbst; ohne s6-notifyoncheck bleibt der s6-Start unvollstaendig und
# docker stop endet erst mit SIGKILL (Exit 137, am RevPi am 20.10.2026).
exec \
    s6-notifyoncheck -d -n 300 -w 1000 -c "nc -z 127.0.0.1 80" \
        /usr/sbin/nginx
